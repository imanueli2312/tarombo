# --- Tarombo environment -----------------------------------------------------
# Salin ke .env (untuk docker compose) atau .env.local (untuk dev),
# lalu sesuaikan. Panduan lengkap: docs/DEPLOYMENT.md

# WAJIB di produksi: secret JWT acak minimal 32 karakter.
# Generate: openssl rand -hex 32
# Aplikasi MENOLAK JALAN di produksi (NODE_ENV=production) tanpa ini.
JWT_SECRET=

# WAJIB di produksi: password admin pertama (minimal 8 karakter, huruf+angka).
# Di development, jika kosong akan memakai 'admin123' + peringatan.
# Ganti password segera setelah login pertama.
SEED_ADMIN_PASSWORD=

# Opsional: email admin pertama (default admin@tarombo.local)
SEED_ADMIN_EMAIL=admin@tarombo.local

# Opsional: lokasi file SQLite (default db/tarombo.db).
# Docker compose memakai /data/tarombo.db (volume persisten app-data).
DATABASE_PATH=db/tarombo.db

# Opsional: marga garis utama aplikasi (default Hariandja).
# CATATAN: di-inline ke bundle klien SAAT BUILD (bukan runtime).
# Docker: docker build --build-arg NEXT_PUBLIC_MARGA_UTAMA=<NamaMarga> .
NEXT_PUBLIC_MARGA_UTAMA=Hariandja

# --- Backup (opsional, dipakai scripts/backup-db.ts) -------------------------
# BACKUP_DIR=backups
# BACKUP_KEEP_DAYS=14
# BACKUP_GZIP=1
