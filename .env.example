# --- Tarombo environment ---
# Salin ke .env.local lalu sesuaikan.

# WAJIB di produksi: secret JWT acak minimal 32 karakter.
# Generate: openssl rand -hex 32
JWT_SECRET=

# WAJIB di produksi: password admin pertama (minimal 8 karakter, huruf+angka).
# Di development, jika kosong akan memakai 'admin123' + peringatan.
SEED_ADMIN_PASSWORD=

# Opsional: email admin pertama (default admin@tarombo.local)
SEED_ADMIN_EMAIL=admin@tarombo.local

# Opsional: lokasi file SQLite (default db/tarombo.db)
DATABASE_PATH=db/tarombo.db

# Opsional: marga garis utama aplikasi (default Hariandja)
NEXT_PUBLIC_MARGA_UTAMA=Hariandja
