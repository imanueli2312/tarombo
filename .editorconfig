# EditorConfig — konsistensi format lintas editor/OS (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown: spasi trailing bisa jadi hard-break yang disengaja
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
