# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# ---- Hardening: file kerja & data tidak boleh masuk repo ----
# Database SQLite (berisi hash password & data keluarga) — dibuat otomatis saat runtime
db/*.db
db/*.db-shm
db/*.db-wal
db/*.sqlite*

# Backup database lokal (JANGAN masuk repo — berisi data keluarga)
backups/
*.db.tmp

# Environment (kecuali template contoh)
.env*
!.env.example

# Override compose lokal (publish port untuk uji di PC — mis. Windows/Docker Desktop).
# File khusus mesin, tidak untuk repo.
docker-compose.override.yml

# Artefak audit/alat & unggahan lokal
tool-results/
upload/
.zscripts/dev.pid
dev.log
dev.out.log
server.log

# Lockfile npm — repo memakai bun.lock; npm hanya untuk jalur instalasi
# Windows native (lihat docs/DEPLOYMENT.md §5.5). Jangan di-commit.
package-lock.json

# Service worker dihasilkan scripts/gen-sw.mjs dari scripts/sw-template.js
# saat `bun run dev` / `bun run build` — versi cache terikat build (audit T-06).
public/sw.js
